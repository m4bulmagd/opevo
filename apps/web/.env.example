NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_REALTIME_ENABLED=false
CLERK_SECRET_KEY=

# ======= LOCAL DEVELOPMENT ONLY =======
# Compose supplies these server-only values for the provider-free activation
# journey. Uncomment only when running Next.js outside Compose. Never rename or
# copy LOCAL_AUTH_TOKEN into a NEXT_PUBLIC_* variable.
# AUTH_MODE=local
# LOCAL_AUTH_TOKEN=presvo-local-development-token
# BILLING_MODE=fake
# TELEPHONY_MODE=fake

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
AUTH_PROVIDER=supabase
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_REALTIME_ENABLED=false
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ======= STANDARD INTERACTIVE AUTHENTICATION =======
# Choose clerk or supabase with AUTH_PROVIDER. Only the selected provider's
# values are required. Supabase uses its project URL and publishable key; Clerk
# uses its publishable and secret keys. The API verifies sessions independently.

# ======= EXPLICIT SYNTHETIC LOCAL AUTH (DEVELOPMENT ONLY) =======
# Opt in only for a provider-free manual test. Never rename or copy
# LOCAL_AUTH_TOKEN into a NEXT_PUBLIC_* variable.
# AUTH_PROVIDER=local
# LOCAL_AUTH_TOKEN=replace-with-a-development-only-token
# BILLING_MODE=fake
# TELEPHONY_MODE=fake

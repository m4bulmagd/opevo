NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_REALTIME_ENABLED=false
CLERK_SECRET_KEY=

# ======= STANDARD INTERACTIVE AUTHENTICATION =======
# Normal Compose development uses Clerk. Set the Clerk publishable and secret
# keys in this file; the API verifies sessions with its own Clerk settings.

# ======= EXPLICIT SYNTHETIC LOCAL AUTH (DEVELOPMENT ONLY) =======
# Opt in only for a provider-free manual test. Never rename or copy
# LOCAL_AUTH_TOKEN into a NEXT_PUBLIC_* variable.
# AUTH_MODE=local
# LOCAL_AUTH_TOKEN=replace-with-a-development-only-token
# BILLING_MODE=fake
# TELEPHONY_MODE=fake

# ======= LIVEKIT =======
APP_ENV=development
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
LIVEKIT_AGENT_NAME=ai-call-agent

# ======= OPTIONAL PRESVO TELEMETRY =======
# Leave the endpoint empty to disable Presvo's private OTLP exporter. LiveKit
# session content export is disabled separately in the agent runtime.
OTEL_SERVICE_NAME=presvo-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf


API_BASE_URL=http://api:8000
REDIS_URL=redis://redis:6379/0

# ======= AI =======
AGENT_DEBUG_STREAMS=false
AGENT_MIN_ENDPOINTING_DELAY=0.25
AGENT_MAX_ENDPOINTING_DELAY=1.5
LIVEKIT_SILERO_VAD_ENABLED=true
LIVEKIT_TURN_DETECTOR_ENABLED=true
SPEECHMATICS_API_KEY=replace-me
SPEECHMATICS_TURN_DETECTION_MODE=adaptive
GEMINI_API_KEY=replace-me
# Compatibility fallback for older local env files:
# GEMINI_API_KEY=replace-me
MISTRAL_API_KEY=replace-me
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_VOICE_ID=replace-me
DEEPGRAM_API_KEY=replace-me

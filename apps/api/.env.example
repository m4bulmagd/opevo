APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_call
REDIS_URL=redis://localhost:6379/0
# Development-only compatibility fallback for local agents.
AGENT_INTERNAL_API_TOKEN=replace-me
# Required outside development. Use a long, random secret shared only with the API.
AGENT_DISPATCH_JWT_SECRET=replace-with-a-long-random-secret
# Covers the 3600-second maximum call plus dispatch/finalization grace.
AGENT_DISPATCH_JWT_TTL_SECONDS=7200

# ======= STRIPE =======
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=
CLERK_JWKS_URL=replace-me
CLERK_WEBHOOK_SECRET=replace-me

# ======= STRIPE =======
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_CHECKOUT_SUCCESS_URL=https://your-app.example.com/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://your-app.example.com/billing/cancel
STRIPE_BILLING_PORTAL_RETURN_URL=https://your-app.example.com/dashboard/billing

# ======= LIVEKIT =======
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_AGENT_NAME=ai-call-agent

# ======= TELNYX =======
TELNYX_API_KEY=replace-me
TELNYX_ACTIVE_CONNECTION_ID=replace-me
TELNYX_DISABLED_CONNECTION_ID=replace-me
TELNYX_ORDERING_ENABLED=false


STORAGE_BUCKET_NAME=recordings

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

FIREBASE_CREDENTIALS_JSON=

GEMINI_API_KEY=
SUMMARY_PROVIDER=gemini
SUMMARY_MODEL=gemini-2.5-flash

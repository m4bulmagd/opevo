APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_call
REDIS_URL=redis://localhost:6379/0
# Independent ARQ capacity controls; queue names and job policies are code-owned.
WORKER_LIFECYCLE_MAX_JOBS=10
WORKER_BACKGROUND_MAX_JOBS=4
# Optional observer only. Keep disabled until the documented identity-key mismatch is resolved.
REALTIME_ENABLED=false
# Use a long, random secret shared only by the API and worker.
AGENT_DISPATCH_JWT_SECRET=replace-with-a-long-random-secret
# Covers the 3600-second maximum call plus dispatch/finalization grace.
AGENT_DISPATCH_JWT_TTL_SECONDS=7200

# ======= EXPLICIT SYNTHETIC LOCAL AUTH (DEVELOPMENT ONLY) =======
# Normal Compose development authenticates interactive users with Clerk. Local
# identity is an explicit provider-free test opt-in; fake providers do not
# imply a synthetic user. Keep LOCAL_AUTH_TOKEN server-only; never expose it
# through NEXT_PUBLIC_* values. Configure workers separately; local identity
# credentials must never enter a worker environment.
# AUTH_MODE=local
# LOCAL_AUTH_TOKEN=replace-with-a-development-only-token
# BILLING_MODE=fake
# CARRIER_LOOKUP_MODE=fake
# TELEPHONY_MODE=fake
# ACTIVATION_FLOW_ENABLED=true

# ======= OPTIONAL OPEVO TELEMETRY =======
# Leave the endpoint empty to disable OTLP export. Telemetry is never required
# for liveness or readiness.
OTEL_SERVICE_NAME=opevo-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ======= CLERK SESSION VERIFICATION =======
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=
# Comma-separated allowlist of browser application origins accepted in azp.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3000,http://localhost:3000
# Configure exactly one verification source: a PEM public key or a JWKS URL.
CLERK_JWT_KEY=
CLERK_JWKS_URL=
CLERK_JWKS_CACHE_TTL_SECONDS=300
CLERK_JWKS_STALE_GRACE_SECONDS=600
CLERK_JWKS_CONNECT_TIMEOUT_SECONDS=0.5
CLERK_JWKS_READ_TIMEOUT_SECONDS=1.0
CLERK_JWKS_POOL_TIMEOUT_SECONDS=0.25
CLERK_JWKS_TOTAL_TIMEOUT_SECONDS=2.0
CLERK_WEBHOOK_SECRET=replace-me

# ======= STRIPE =======
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_CHECKOUT_SUCCESS_URL=https://your-app.example.com/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://your-app.example.com/billing/cancel
STRIPE_BILLING_PORTAL_RETURN_URL=https://your-app.example.com/dashboard/billing
# Create this Portal configuration in Stripe. It must allow cancellation only
# at period end and have proration disabled; this app stores only its bpc_ ID.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_replace_me

# ======= LIVEKIT =======
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_AGENT_NAME=ai-call-agent

# ======= TELNYX =======
TELNYX_API_KEY=replace-me
TELNYX_ACTIVE_CONNECTION_ID=replace-me
TELNYX_DISABLED_CONNECTION_ID=replace-me
# Safe no-charge development default. Set explicitly to true in staging and production.
TELNYX_ORDERING_ENABLED=false


STORAGE_BUCKET_NAME=recordings

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

FIREBASE_CREDENTIALS_JSON=

GEMINI_API_KEY=
SUMMARY_PROVIDER=gemini
SUMMARY_MODEL=gemini-2.5-flash
